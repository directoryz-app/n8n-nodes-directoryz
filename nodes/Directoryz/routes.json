{
	"get_profile": {
		"method": "GET",
		"path": "/v1/account"
	},
	"list_directories": {
		"method": "GET",
		"path": "/v1/directories",
		"pagination": {
			"items": ["directories"],
			"kind": "complete"
		}
	},
	"get_directory": {
		"method": "GET",
		"path": "/v1/directories/:directoryId"
	},
	"list_listings": {
		"method": "GET",
		"path": "/v1/directories/:directoryId/listings",
		"pagination": {
			"items": ["items"],
			"kind": "page"
		}
	}
}
